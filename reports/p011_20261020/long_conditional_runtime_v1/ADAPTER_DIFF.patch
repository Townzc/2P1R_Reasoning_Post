+            or not 0<proof.get('completed_epoch',0)<1792587018.9038124
+            or proof.get('full_state',{}).get('updates')!=2
+            or proof['full_state'].get('targets')!=65082):
+        raise ValueError('Actual original F15 local proof condition absent')
+    return old
